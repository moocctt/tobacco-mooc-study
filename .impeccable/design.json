  "narrative": {
    "northStar": "学习助手",
    "overview": "这不是一个要被欣赏的界面，而是一个贴在浏览器角落、随时交接状态与下一步动作的小工具。它借用宿主页面的顶栏色作为强调色，自己不发明品牌色；信息密度紧凑，读数比装饰优先，日志比氛围重要。用户扫一眼就知道「跑到哪、还要不要点停止」。\n\n整体气质是克制、可信、即时反馈。面板始终待在右下角，可拖拽、可折叠；展开时自上而下是进度区、启动/停止按钮、滚动日志三块。按钮本身就是进度条，不再单独开一行控件；运行态默认显示进度，只有鼠标悬停或键盘聚焦才露出停止动作——工具不催你，但随时让你能刹车。",
    "keyCharacteristics": [
      "强调色从宿主页面借来，面板本体保持中性半透明白。",
      "按钮即仪表：已完成比例从左往右填亮，文字同步给出状态与百分比。",
      "折叠后标题栏仍钉住状态与百分比，不必展开就知道跑到哪。",
      "紧凑、等宽、带时间戳的日志区承担全部过程解释。",
      "只有一层柔和投影；深度来自半透明与毛玻璃，不来自多重描边。"
    ],
    "rules": [
      { "name": "The Borrowed Signal Rule", "body": "强调色只从宿主页面顶栏借来；工具自己不发明品牌色。焦点蓝是唯一例外，且只给键盘焦点。", "section": "colors" },
      { "name": "The Tabular Rule", "body": "所有会跳动的数字都用 tabular-nums，避免进度刷新时文字左右抖动。", "section": "typography" },
      { "name": "The One-Layer Rule", "body": "面板只有一层投影；更深的层级用半透明和毛玻璃表达，不用再叠一层阴影。", "section": "elevation" },
      { "name": "The Button-Is-The-Gauge Rule", "body": "按钮本身就是进度条；不为进度再开一行独立控件。", "section": "components" }
    ],
    "dos": [
      "Do 从宿主页面顶栏取强调色，并按亮度切黑/白字。",
      "Do 让按钮自己承担进度反馈，文字同时给状态与百分比。",
      "Do 在悬停/键盘聚焦时才把运行态按钮切成停止，触屏无 hover 时直接显示停止。",
      "Do 折叠后仍在标题栏给出状态与百分比。",
      "Do 用 tabular-nums 固定所有跳动的数字宽度。",
      "Do 保持一层投影 + 毛玻璃的轻悬浮感。"
    ],
    "donts": [
      "Don't 发明固定品牌色覆盖宿主页面，或用渐变做营销感强调。",
      "Don't 为进度再开一行独立进度条。",
      "Don't 用 title 当按钮名称，或用颜色变化作为唯一状态提示。",
      "Don't 叠多重阴影、内阴影或大圆角卡片来制造层次。",
      "Don't 在标题之外再加 emoji 装饰。"
    ]
  }
}
