  "components": [
    {
      "name": "Panel Card",
      "kind": "card",
      "refersTo": "panel-card",
      "description": "暖纸底、1px 暖灰边框、12px 圆角的悬浮面板，无毛玻璃和阴影。",
      "html": "<section class=\"ds-panel\"><header class=\"ds-head\"><span class=\"ds-head-title\">快速学习助手</span><span class=\"ds-head-right\"><span class=\"ds-head-status\">学习中</span><span class=\"ds-head-pct\">45%</span><svg class=\"ds-head-chev\" viewBox=\"0 0 16 16\" width=\"12\" height=\"12\" aria-hidden=\"true\"><path d=\"M4 6l4 4 4-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></header><div class=\"ds-body\"><p class=\"ds-course\">大学生心理健康教育</p><p class=\"ds-meta\">小节 1/4，课程 2/3</p><p class=\"ds-status\">3.2 认识情绪</p><p class=\"ds-sub\">第 3 轮，已记录 4 分 30 秒 / 共 10 分钟</p></div></section>",
      "css": ".ds-panel{width:min(360px,calc(100vw - 24px));background:#fbf8f3;color:#2a2521;border:1px solid #e5ddd3;border-radius:12px;overflow:hidden;font:13px/1.55 -apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei',sans-serif}.ds-head{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:9px 12px;background:#f2ece3;border-bottom:1px solid #e5ddd3;cursor:pointer}.ds-head-title{font-size:14px;font-weight:650;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ds-head-right{display:flex;align-items:center;gap:8px;flex:0 0 auto}.ds-head-status{display:none;max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px;color:#6e645a}.ds-panel[data-collapsed=\"1\"] .ds-head-status{display:block}.ds-head-pct{font:600 12px/1 ui-monospace,SFMono-Regular,Menlo,Consolas,'Courier New',monospace;color:var(--p-accent)}.ds-head-chev{color:#6e645a}.ds-body{padding:12px}.ds-course{margin:0;font-size:13px;font-weight:650}.ds-meta,.ds-sub{margin:4px 0 0;font-size:12px;color:#6e645a}.ds-status{margin:8px 0 0;font-size:13px}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "44px 高、10px 圆角的全宽按钮；按钮本身同时是进度条。",
      "html": "<button class=\"ds-button\" type=\"button\"><span class=\"ds-track\"></span><span class=\"ds-fill\" style=\"width:45%\"></span><span class=\"ds-label\">学习中 45%</span><span class=\"ds-stoplabel\">停止 45%</span></button>",
      "css": ".ds-button{position:relative;overflow:hidden;display:flex;width:100%;height:44px;align-items:center;justify-content:center;padding:0 12px;border:0;border-radius:10px;background:var(--p-accent);color:var(--p-on-accent);font:600 13px/1 -apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei',sans-serif;cursor:pointer}.ds-button:hover{background:color-mix(in srgb, var(--p-accent) 88%, black)}.ds-button:focus-visible{outline:2px solid var(--p-accent);outline-offset:2px}.ds-track{position:absolute;inset:0;background:rgba(0,0,0,.28)}.ds-fill{position:absolute;left:0;top:0;bottom:0;background:var(--p-accent);transition:width .35s cubic-bezier(.22,.61,.36,1)}.ds-label,.ds-stoplabel{position:relative;z-index:1}.ds-stoplabel{display:none}.ds-button:hover .ds-label,.ds-button:focus-visible .ds-label{display:none}.ds-button:hover .ds-stoplabel,.ds-button:focus-visible .ds-stoplabel{display:inline}@media (hover:none){.ds-label{display:none}.ds-stoplabel{display:inline}}"
    },
    {
      "name": "Log Region",
      "kind": "log",
      "refersTo": "log-region",
      "description": "按钮下方的等宽日志区，空态只留一行提示。",
      "html": "<div class=\"ds-log\"><div><span class=\"ds-ts\">21:45:11</span><span class=\"ds-tx\">已读取登录状态</span></div></div>",
      "css": ".ds-log{min-height:96px;max-height:clamp(140px,26vh,180px);overflow-y:auto;padding:8px 12px 10px;border-top:1px solid #e5ddd3;background:#f6f1e9;font:11px/1.65 ui-monospace,SFMono-Regular,Menlo,Consolas,'Courier New',monospace;color:#2a2521}.ds-log>div{display:flex;gap:6px}.ds-ts{color:#6e645a;flex:0 0 auto}.ds-tx{flex:1 1 auto;min-width:0;white-space:pre-wrap;word-break:break-word}"
    }
  ],
  "narrative": {
    "northStar": "学习助手",
    "overview": "停在页面右下角的学习状态面板：暖纸底、强调色取自宿主导航栏、默认平面。按钮同时是进度条，折叠后仍保留状态和百分比。",
    "keyCharacteristics": [
      "暖纸底与深褐文字",
      "强调色取自宿主导航栏",
      "按钮即进度",
      "默认平面，无阴影和毛玻璃",
      "折叠后仍显示状态与百分比"
    ],
    "rules": [
      "一页一个强调色（取自宿主导航栏）",
      "最多四种字号",
      "同动作同动词",
      "数字带单位和上下文",
      "说明文字不用斜体、等宽或全大写"
    ],
    "dos": [
      "让按钮承担操作和进度",
      "运行中默认显示学习状态，悬停或键盘聚焦显示停止",
      "用“小节 1/4，课程 2/3”这种带上下文的计数",
      "取不到导航栏色时使用脚本各自的回退色"
    ],
    "donts": [
      "不硬编码固定强调色，或让面板与宿主页面完全脱节",
      "不叠阴影、毛玻璃、发光或卡片套卡片",
      "不把技术词直接丢给普通用户",
      "不用 title 当按钮名称"
    ]
  }
