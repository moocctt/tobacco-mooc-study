      "description": "右下角悬浮面板的中性半透明容器。",
      "html": "<section class=\"ds-panel\"><header class=\"ds-head\"><span class=\"ds-head-title\">课程名</span><span class=\"ds-head-right\"><span class=\"ds-head-status\">▶ 播放中</span><span class=\"ds-head-pct\">45%</span><svg class=\"ds-head-chev\" viewBox=\"0 0 16 16\" width=\"12\" height=\"12\" aria-hidden=\"true\"><path d=\"M4 6l4 4 4-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></header></section>",
      "css": ".ds-panel{background:rgba(255,255,255,.92);color:#1f2328;border:1px solid #e6eaef;border-radius:10px;backdrop-filter:blur(10px) saturate(1.15);box-shadow:0 10px 30px -8px rgba(0,0,0,.32),0 2px 8px rgba(0,0,0,.06);font:400 12px/1.5 -apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei',sans-serif;padding:10px;overflow:hidden}.ds-head{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:7px 10px;margin:-10px -10px 0;background:#57606a;color:#fff;cursor:pointer;user-select:none}.ds-head-title{font-weight:600;letter-spacing:.01em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ds-head-right{display:flex;align-items:center;gap:7px;flex:0 0 auto}.ds-head-pct{font:600 11px/1 ui-monospace,SFMono-Regular,Menlo,Consolas,'Courier New',monospace;font-variant-numeric:tabular-nums;opacity:.85}.ds-head-status{display:none;max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:11px;opacity:.85;font-variant-numeric:tabular-nums}.ds-panel[data-collapsed=\"1\"] .ds-head-status{display:block}.ds-head-chev{display:block;opacity:.75;transition:transform .18s ease,opacity .18s ease}.ds-head:hover .ds-head-chev{opacity:1}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "待机态的启动/继续按钮。",
      "html": "<button class=\"ds-btn\" type=\"button\">执行学习任务</button>",
      "css": ".ds-btn{display:flex;width:100%;align-items:center;justify-content:center;height:30px;padding:0 10px;border:0;border-radius:7px;background:#57606a;color:#fff;font:600 12px/1 -apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei',sans-serif;letter-spacing:.01em;cursor:pointer;transition:filter .15s ease}.ds-btn:hover{filter:brightness(1.07)}.ds-btn:active{filter:brightness(.96)}.ds-btn:focus-visible{outline:2px solid #0969da;outline-offset:2px}"
    },
    {
      "name": "Running Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "运行态按钮：自身即进度条，悬停/聚焦才露出停止。",
      "html": "<button class=\"ds-btn-running\" type=\"button\"><span class=\"ds-track\"></span><span class=\"ds-fill\" style=\"width:45%\"></span><span class=\"ds-label\">进行中 45%</span><span class=\"ds-stop\">⏸ 停止 45%</span></button>",
      "css": ".ds-btn-running{position:relative;overflow:hidden;display:flex;width:100%;align-items:center;justify-content:center;height:30px;padding:0 10px;border:0;border-radius:7px;background:#57606a;color:#fff;font:600 12px/1 -apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei',sans-serif;letter-spacing:.01em;cursor:pointer;transition:filter .15s ease}.ds-btn-running:hover{filter:brightness(1.07)}.ds-btn-running:active{filter:brightness(.96)}.ds-btn-running:focus-visible{outline:2px solid #0969da;outline-offset:2px}.ds-track{position:absolute;inset:0;background:rgba(0,0,0,.26);opacity:1;transition:opacity .2s ease;pointer-events:none}.ds-fill{position:absolute;left:0;top:0;bottom:0;background:#57606a;transition:width .35s cubic-bezier(.22,.61,.36,1);pointer-events:none}.ds-label,.ds-stop{position:relative;z-index:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ds-stop{display:none}.ds-btn-running:hover .ds-label,.ds-btn-running:focus-visible .ds-label{display:none}.ds-btn-running:hover .ds-stop,.ds-btn-running:focus-visible .ds-stop{display:block}@media (hover:none){.ds-btn-running .ds-label{display:none}.ds-btn-running .ds-stop{display:block}}"
    },
